# Copy this file to backend/.env for local development.
# Never commit real credentials or share them in chat.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=security_dashboard

# Generate a long random value for production; keep it private.
SECRET_KEY=replace_with_a_long_random_secret
COOKIE_SECURE=false
