# Local default: SQLite. No MySQL/XAMPP setup is needed.
DB_DRIVER=sqlite
SQLITE_PATH=backend/security_dashboard.db

# Optional local demo login (change these before sharing your computer).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Keep this private. The app generates a temporary key if omitted locally.
SECRET_KEY=change_this_to_a_long_random_secret
COOKIE_SECURE=false

# Optional: set DB_DRIVER=mysql and configure these to use MySQL/MariaDB.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=security_dashboard
